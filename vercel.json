{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://scalable-sis-backend.onrender.com/api/$1"
    },
    {
      "source": "/r/(.*)",
      "destination": "https://scalable-sis-backend.onrender.com/r/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
